<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.colton.audio-archive.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ARCHIVE_BIN}}</string>
        <string>worker</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Working directory is the project root. Historically this was
         needed so config.findProjectRoot() could locate the Python venv;
         post whisper.cpp cutover it's still useful for debug symlinks
         and relative path fallbacks. -->
    <key>WorkingDirectory</key>
    <string>{{PROJECT_ROOT}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{DATA_DIR}}/logs/worker.log</string>

    <key>StandardErrorPath</key>
    <string>{{DATA_DIR}}/logs/worker.err</string>

    <!-- CRITICAL: do NOT set ProcessType=Background.
         Background is for maintenance work that can tolerate being
         pinned to E-cores and preempted by anything; it catastrophically
         throttles CPU-/GPU-intensive workloads like whisper.cpp. In
         testing, Background caused whisper-cli to run ~200x slower than
         the same invocation from a normal shell — because the kernel
         refused to schedule it on P-cores or give it normal GPU
         priority. Leaving ProcessType unset (== "Standard") gives the
         worker normal priority, which is what we want: the user
         started this daemon so they could have transcripts. -->
</dict>
</plist>
